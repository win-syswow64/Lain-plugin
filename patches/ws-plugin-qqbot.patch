@@ -0,0 +1,45 @@
+/** QQBot exposes bound QQ users only. No whitelist-only official request is made. */
+export function getQQBotBoundMembers (bot, groupId, requestedGroupId, adapter) {
+  const mapper = globalThis.Bot?.QQBotIdMap
+  const marker = bot?.adapter
+  const route = bot?.__qqbotIdMapRoutes?.groups?.get(Number(groupId)) || bot?.__qqbotIdMapRoutes?.groups?.get(Number(requestedGroupId))
+  const isQQBot = !!route || adapter?.name === 'QQBot' || marker === 'QQBot' || marker?.id === 'QQBot' || bot?.qqbot_bot?.adapter === 'QQBot'
+  if (!isQQBot) return null
+  if (!mapper?.getCachedGroupMemberMap) return []
+  mapper.load()
+  let appid = route?.qqbotSelfId || bot?.qqbot_bot?.config?.appid || bot?.config?.appid
+  if (!appid) {
+    appid = Object.keys(mapper.data.bots || {}).find(id => String(mapper.getBoundBotQQ(id)) === String(bot?.uin)) || bot?.uin
+  }
+  const numeric = /^\d+$/.test(String(groupId))
+  return Array.from(mapper.getCachedGroupMemberMap({
+    self_id: String(appid),
+    group_openid: route?.groupOpenid || (numeric ? '' : groupId),
+    group_qq: numeric ? Number(groupId) : Number(requestedGroupId) || '',
+    qq_self_id: bot?.uin
+  }).values())
+}
+
+/** Exact OneBot field types; timestamp defaults are Unix seconds, not milliseconds. */
+export function normalizeGroupMember (member, groupId, userId, now = Math.floor(Date.now() / 1000), boundOnly = false) {
+  const data = member?.info ? { ...member, ...member.info } : member || {}
+  const number = value => Number.isFinite(Number(value)) ? Number(value) : 0
+  const string = value => typeof value === 'string' && value.length ? value : ' '
+  return {
+    group_id: number(groupId),
+    user_id: number(userId),
+    nickname: string(data.nickname),
+    card: string(data.card),
+    sex: boundOnly ? ' ' : string(data.sex),
+    age: boundOnly ? 0 : number(data.age),
+    area: boundOnly ? ' ' : string(data.area),
+    join_time: boundOnly ? now : number(data.join_time) || now,
+    last_sent_time: boundOnly ? now : number(data.last_sent_time) || now,
+    level: boundOnly ? ' ' : string(data.level),
+    role: string(data.role),
+    unfriendly: boundOnly ? false : data.unfriendly === true,
+    title: boundOnly ? ' ' : string(data.title),
+    title_expire_time: boundOnly ? now : number(data.title_expire_time) || now,
+    card_changeable: boundOnly ? false : data.card_changeable === true
+  }
+}
